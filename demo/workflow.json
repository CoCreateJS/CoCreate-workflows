{
  "_id": "f10731474570ee016a4f3721",
  "name": "unique",
  "description": "Checks whether a value is available for a key in a CRUD array.",
  "enabled": true,
  "actions": {
    "lookup": {
      "$crud.send": {
        "method": "object.read",
        "array": "$payload.unique.0.array",
        "filter": {
          "query": {
            "{{ $payload.unique.0.key }}": "$payload.unique.0.value"
          },
          "limit": 2
        }
      }
    },
    "$data.unique": {
      "$if.$actions.lookup.object.0.$exists": {
        "$true": false,
        "$else": true
      }
    }
  },
  "response": {
    "$this.setAttribute": ["unique", "$payload.unique"]
  }
}
