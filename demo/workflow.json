{
  "_id": "f10731474570ee016a4f3721",
  "name": "unique",
  "description": "Checks whether a key value already exists in a CRUD array.",
  "enabled": true,
  "actions": {
    "lookup": {
      "$crud.send": {
        "method": "object.read",
        "array": "$payload.workflow.array",
        "filter": {
          "query": {
            "{{ $payload.workflow.key }}": "$payload.workflow.value"
          },
          "limit": 1
        }
      }
    }
  },
  "data": {
    "unique": {
      "$if.$actions.lookup.object.length.$lt": {
        "1": true,
        "$else": false
      }
    }
  }
}
